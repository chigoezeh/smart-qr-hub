# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Advanced Page Builder (Phase 2+)
# Set to "true" to enable the advanced hierarchical page builder with visual design tools
NEXT_PUBLIC_ENABLE_ADVANCED_BUILDER="false"

# Clerk Authentication (Get from https://dashboard.clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# AI Services (Optional but recommended for AI features)
# Get OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Get Unsplash access key from https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=""

# Geolocation Service (Optional - free tier works without key)
IPAPI_KEY=""

# AI-Powered QR Codes (Phase 6 - Stability AI)
STABILITY_API_KEY=""

# Webhook Security
WEBHOOK_SECRET="generate_random_secret_here"
CLERK_WEBHOOK_SECRET="whsec_..."

# JWT Secret for Password-Protected QR Codes
JWT_SECRET="generate_random_secret_here"

# Rate Limiting (Upstash Redis - optional but recommended for production)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""